# Every dependency here is at its latest stable release (D45). TypeScript 7 is
# newer than the peer range typescript-eslint and openapi-typescript currently
# declare (both still cap at TypeScript 5.x/6.x), so strict peer resolution
# would refuse an install that is otherwise exactly what DESIGN section 14 asks
# for. This file is committed so `npm ci` in CI resolves the same way a
# developer's `npm install` does.
#
# Remove this line once typescript-eslint publishes a stable release whose peer
# range admits TypeScript 7.
legacy-peer-deps=true
