# llamaman-units: 1
[Unit]
Description=Llama Man instances
Documentation=https://github.com/jlbyh2o/llamaman
After=basic.target
# Autostart is EnableUnitFiles linking an instance unit into this target, which
# also gives one lever for "stop everything for maintenance". Because this target
# starts enabled instances at boot WITHOUT the daemon being involved at all,
# instances.autostart and instances.desired_state must agree at that moment —
# which is what the D53 coupling guarantees.
AllowIsolate=no

[Install]
WantedBy=default.target
