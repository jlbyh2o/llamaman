#!/bin/sh
# Fake `cmake` for internal/llamacpp/source.
#
# DESIGN section 15 asks for exactly this: "a fake source tree whose cmake is a
# shell script printing Ninja-style progress and exiting 0 or 1 on demand — this
# exercises the whole phase machine, log streaming, cancellation, the symlink
# flip and rollback WITHOUT compiling llama.cpp, and it is why this area can be
# tested at all."
#
# Everything is driven by environment variables, because the argv it receives
# has to stay byte-for-byte what real cmake would get: a fake that needed flags
# of its own would force the test to bypass ConfigureArgs, and bypassing the
# renderer is bypassing the thing under test.
#
#   FAKE_STATE        directory this fake records calls in (required)
#   FAKE_CMAKE_VERSION  what `--version` prints          (default 3.28.3)
#   FAKE_CONFIGURE    ok | fail                          (default ok)
#   FAKE_COMPILE      ok | fail | oom | oom_once | hang  (default ok)
#   FAKE_INSTALL      ok | fail | missing_bench | no_lib (default ok)
set -u

state="${FAKE_STATE:-/tmp/llamaman-fakecmake}"
mkdir -p "$state"
printf '%s\n' "$*" >>"$state/cmake.args"

case "${1:-}" in
--version)
	echo "cmake version ${FAKE_CMAKE_VERSION:-3.28.3}"
	echo ""
	echo "CMake suite maintained and supported by Kitware (kitware.com/cmake)."
	exit 0
	;;

--build)
	shift
	builddir="${1:-}"
	jobs=""
	while [ "$#" -gt 0 ]; do
		if [ "$1" = "-j" ]; then
			shift
			jobs="${1:-}"
		fi
		shift
	done
	printf '%s\n' "$jobs" >>"$state/jobs"

	attempt=$(cat "$state/attempts" 2>/dev/null || echo 0)
	attempt=$((attempt + 1))
	printf '%s\n' "$attempt" >"$state/attempts"

	if [ ! -f "$builddir/CMakeCache.txt" ]; then
		echo "Error: could not load cache" >&2
		exit 1
	fi

	echo "[1/3] Building C object ggml/src/CMakeFiles/ggml-base.dir/ggml.c.o"
	echo "[2/3] Building CXX object src/CMakeFiles/llama.dir/llama-model.cpp.o"

	case "${FAKE_COMPILE:-ok}" in
	oom)
		echo "c++: fatal error: Killed signal terminated program cc1plus" >&2
		echo "ninja: build stopped: subcommand failed." >&2
		exit 1
		;;
	oom_once)
		if [ "$attempt" -eq 1 ]; then
			echo "c++: fatal error: Killed signal terminated program cc1plus" >&2
			echo "ninja: build stopped: subcommand failed." >&2
			exit 1
		fi
		;;
	fail)
		echo "/src/llama.cpp:4212:7: error: use of undeclared identifier 'ggml_nope'" >&2
		echo "ninja: build stopped: subcommand failed." >&2
		exit 1
		;;
	hang)
		echo "[3/3] Linking CXX executable bin/llama-server"
		sleep 120
		exit 0
		;;
	esac

	echo "[3/3] Linking CXX executable bin/llama-server"
	exit 0
	;;

--install)
	builddir="${2:-}"
	if [ "${FAKE_INSTALL:-ok}" = "fail" ]; then
		echo "CMake Error: install target not found" >&2
		exit 1
	fi
	prefix=$(sed -n 's/^CMAKE_INSTALL_PREFIX=//p' "$builddir/CMakeCache.txt")
	if [ -z "$prefix" ]; then
		echo "CMake Error: no install prefix in the cache" >&2
		exit 1
	fi

	mkdir -p "$prefix/bin"
	if [ "${FAKE_INSTALL:-ok}" != "no_lib" ]; then
		mkdir -p "$prefix/lib"
		: >"$prefix/lib/libggml-base.so"
		: >"$prefix/lib/libllama.so"
	fi
	echo "-- Installing: $prefix/bin/llama-server"

	# The stand-in for llama-server answers the three probes the `verify` phase
	# runs (D18's --version, D19's --list-devices, and the --help capture that
	# becomes help_flags_json), reading its answers from FAKE_STATE so one test
	# can make the same installed tree pass or fail.
	cat >"$prefix/bin/llama-server" <<'SERVER'
#!/bin/sh
state="${FAKE_STATE:-/tmp/llamaman-fakecmake}"
case "${1:-}" in
--version)
	if [ -n "${FAKE_SERVER_BROKEN:-}" ]; then
		echo "llama-server: error while loading shared libraries: libggml-base.so: cannot open shared object file" >&2
		exit 127
	fi
	echo "version: 6000 (deadbee)"
	echo "built with cc (GCC) 14.2.0 for x86_64-pc-linux-gnu"
	exit 0
	;;
--list-devices)
	if [ -f "$state/devices.txt" ]; then
		cat "$state/devices.txt"
	else
		echo "Available devices:"
	fi
	exit 0
	;;
--help)
	if [ -f "$state/help.txt" ]; then
		cat "$state/help.txt"
	else
		echo "----- common params -----"
		echo ""
		printf -- '-h,    --help, --usage          print usage and exit\n'
		printf -- '-c,    --ctx-size N             size of the prompt context (default: 4096)\n'
		printf -- '       --fit                    let llama.cpp choose the offload\n'
	fi
	exit 0
	;;
esac
exit 0
SERVER
	chmod +x "$prefix/bin/llama-server"

	if [ "${FAKE_INSTALL:-ok}" != "missing_bench" ]; then
		cat >"$prefix/bin/llama-bench" <<'BENCH'
#!/bin/sh
# llama-bench has its own parser and exits non-zero on an unknown flag, which is
# exactly why section 6.4 accepts it on its OUTPUT rather than on its status.
echo "usage: llama-bench [options]"
exit 1
BENCH
		chmod +x "$prefix/bin/llama-bench"
	fi

	cat >"$prefix/bin/llama-cli" <<'CLI'
#!/bin/sh
echo "version: 6000 (deadbee)"
exit 0
CLI
	chmod +x "$prefix/bin/llama-cli"
	exit 0
	;;
esac

# Anything else is a configure run.
builddir=""
prefix=""
prev=""
for a in "$@"; do
	if [ "$prev" = "-B" ]; then builddir="$a"; fi
	case "$a" in
	-DCMAKE_INSTALL_PREFIX=*) prefix="${a#-DCMAKE_INSTALL_PREFIX=}" ;;
	esac
	prev="$a"
done

if [ -z "$builddir" ]; then
	echo "CMake Error: no build directory was given with -B" >&2
	exit 1
fi
if [ "${FAKE_CONFIGURE:-ok}" = "fail" ]; then
	echo "CMake Error at CMakeLists.txt:1 (project):" >&2
	echo "  No CMAKE_CUDA_COMPILER could be found." >&2
	exit 1
fi

mkdir -p "$builddir"
printf 'CMAKE_INSTALL_PREFIX=%s\n' "$prefix" >"$builddir/CMakeCache.txt"
echo "-- The CXX compiler identification is GNU 14.2.0"
echo "-- Configuring done"
echo "-- Generating done"
echo "-- Build files have been written to: $builddir"
exit 0
